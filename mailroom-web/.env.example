# Production should use the platform-provided PORT and HTTPS domain.
PORT=8080
# Optional: exact public HTTPS origin, without a trailing slash.
# PUBLIC_ORIGIN=https://your-app.up.railway.app
# Local development only; do not enable this in hosted deployments.
# MAILROOM_ALLOW_HTTP=1

# Configured ONCE by the site owner, never by visitors. Keep secrets in Railway.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Register exact Web redirect URIs on the provider's application:
# https://your-app.up.railway.app/oauth/callback/google
# https://your-app.up.railway.app/oauth/callback/microsoft
