        "inventory_valid": {
          "name": "inventory_valid",
          "value": "\"products\".\"stock\" >= \"products\".\"reserved\" AND \"products\".\"reserved\" >= 0"
        },
        "price_valid": {
          "name": "price_valid",
          "value": "(\"products\".\"price_cents\" IS NULL OR \"products\".\"price_cents\" > 0) AND (\"products\".\"minimum_cents\" IS NULL OR (\"products\".\"minimum_cents\" > 0 AND \"products\".\"minimum_cents\" <= \"products\".\"price_cents\"))"
        }
